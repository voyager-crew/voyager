{
  "controls": [":not(*)"],
  "broadControls": [":not(*)"],
  "canvasOwner": ":not(*)",
  "canvasContent": ":not(*)",
  "fullscreenCanvas": ":not(*)",
  "inactiveCanvas": "[hidden], [aria-hidden=\"true\"]",
  "turns": ".ds-message:has(.ds-collapsible-text):not(:has(.ds-assistant-message-main-content, .ds-think-content)), .ds-message:has(.ds-assistant-message-main-content, .ds-think-content)",
  "interactive": "button, a[href], [role=\"button\"]",
  "avoidRow": false,
  "overlaySidebar": [
    "[data-test-id=\"side-nav\"]",
    "side-navigation",
    "mat-sidenav",
    "aside",
    "nav",
    ".side-nav",
    ".sidenav",
    ".chat-history-nav"
  ],
  "fallbackRoot": "main",
  "alignmentCanvas": [
    "#chat-history",
    "infinite-scroller.chat-history",
    ".chat-history-scroll-container",
    "chat-window-content",
    "main chat-window-content"
  ],
  "alignmentComposer": [
    "rich-textarea",
    "[aria-label*=\"Enter a prompt\"]",
    "[aria-label*=\"prompt\"]",
    "[aria-label*=\"Gemini\"]",
    "[contenteditable=\"true\"][aria-label]"
  ]
}
