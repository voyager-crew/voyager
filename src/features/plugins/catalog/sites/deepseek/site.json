{
  "$schema": "https://voyager.nagi.fun/site.schema.json",
  "id": "deepseek",
  "label": "DeepSeek",
  "matches": ["https://chat.deepseek.com/*"],
  "selectors": {
    "userTurn": ".ds-message:has(.ds-collapsible-text):not(:has(.ds-assistant-message-main-content, .ds-think-content))",
    "assistantTurn": ".ds-message:has(.ds-assistant-message-main-content, .ds-think-content)",
    "thinkingBlock": ".ds-think-content",
    "codeBlock": ".md-code-block",
    "composer": "textarea.ds-scroll-area",
    "sidebar": "div:not(.ds-scroll-area):has(> .ds-scroll-area a[href^=\"/a/chat/s/\"])",
    "scrollContainer": ".ds-virtual-list.ds-scroll-area",
    "composerRoot": "div:has(> div > textarea.ds-scroll-area)",
    "sendButton": "div:has(> div > textarea.ds-scroll-area) div.ds-button--primary.ds-button--circle[role=\"button\"]"
  },
  "theme": {
    "hostSelector": "body",
    "lightSelector": "body.light",
    "darkSelector": "body.dark"
  },
  "brandColor": "#4d6bfe",
  "capabilities": ["chat", "composer", "darkMode"],
  "conversationIdPattern": "^/a/chat/s/([^/?#]+)",
  "routeWords": ["a", "chat", "s"],
  "export": {
    "version": 1,
    "read": "virtual",
    "messageKey": "data-virtual-list-item-key"
  },
  "folders": {
    "format": 1,
    "sidebar": "div:not(.ds-scroll-area):has(> .ds-scroll-area a[href^=\"/a/chat/s/\"]:not(.ds-virtual-list *))",
    "rows": {
      "row": "a[href^=\"/a/chat/s/\"]",
      "drag": "link"
    },
    "mount": {
      "anchors": [
        {
          "id": "above-history",
          "steps": [
            {
              "find": ".ds-scroll-area > :has(> * > a[href^=\"/a/chat/s/\"])"
            },
            {
              "find": ":has(> a[href^=\"/a/chat/s/\"])"
            }
          ]
        }
      ]
    },
    "page": {
      "placeholderTitles": {
        "any": ["New chat", "新对话", "新對話", "新しいチャット", "DeepSeek", "DSeek"]
      },
      "titleSuffix": "\\s+-\\s+(?:DeepSeek|DSeek)$"
    }
  },
  "folderSkin": {
    "rowHeight": "40px",
    "rowRadius": "12px",
    "light": {
      "heading": "var(--dsw-alias-label-tertiary, #81858c)",
      "text": "var(--dsw-alias-label-primary, #0f1115)",
      "textMuted": "var(--dsw-alias-label-secondary, #545b66)",
      "surface": "var(--dsw-alias-bg-layer-2, #ffffff)",
      "surfaceContainer": "var(--dsw-alias-bg-layer-1, #ffffff)",
      "surfaceHover": "var(--dsw-alias-interactive-bg-hover, rgba(0, 0, 0, 0.04))",
      "surfaceActive": "var(--dsw-alias-interactive-bg-active, rgba(0, 0, 0, 0.08))",
      "outline": "var(--dsw-alias-border-l2, rgba(0, 0, 0, 0.12))",
      "danger": "var(--dsw-alias-state-error-primary, #ef4444)",
      "dangerSoft": "var(--dsw-alias-interactive-bg-hover-danger, color-mix(in oklab, #ef4444 8%, transparent))",
      "sidebar": "var(--dsw-specific-sidebar-fill, #f9fafb)"
    },
    "dark": {
      "heading": "var(--dsw-alias-label-tertiary, #adb2b8)",
      "text": "var(--dsw-alias-label-primary, #f9fafb)",
      "textMuted": "var(--dsw-alias-label-secondary, #cfd3d6)",
      "surface": "var(--dsw-alias-bg-layer-2, #2c2c2e)",
      "surfaceContainer": "var(--dsw-alias-bg-layer-1, #232324)",
      "surfaceHover": "var(--dsw-alias-interactive-bg-hover, rgba(255, 255, 255, 0.08))",
      "surfaceActive": "var(--dsw-alias-interactive-bg-active, rgba(255, 255, 255, 0.12))",
      "outline": "var(--dsw-alias-border-l2, rgba(255, 255, 255, 0.12))",
      "sidebar": "var(--dsw-specific-sidebar-fill, #1b1b1c)"
    },
    "header": {
      "height": 36,
      "paddingInlineEnd": 28
    }
  }
}
