{
  "$schema": "https://voyager.nagi.fun/site.schema.json",
  "id": "deepseek",
  "label": "DeepSeek",
  "matches": ["https://chat.deepseek.com/*"],
  "selectors": {
    "userTurn": ".ds-message:has(.ds-collapsible-text):not(:has(.ds-assistant-message-main-content, .ds-think-content))",
    "assistantTurn": ".ds-message:has(.ds-assistant-message-main-content, .ds-think-content)",
    "thinkingBlock": ".ds-think-content",
    "codeBlock": ".md-code-block",
    "composer": "textarea.ds-scroll-area",
    "sidebar": "div:not(.ds-scroll-area):has(> .ds-scroll-area a[href^=\"/a/chat/s/\"])",
    "scrollContainer": ".ds-virtual-list.ds-scroll-area",
    "composerRoot": "div:has(> div > textarea.ds-scroll-area)",
    "sendButton": "div:has(> div > textarea.ds-scroll-area) div.ds-button--primary.ds-button--circle[role=\"button\"]"
  },
  "theme": {
    "hostSelector": "body",
    "lightSelector": "body.light",
    "darkSelector": "body.dark"
  },
  "brandColor": "#4d6bfe",
  "capabilities": ["chat", "composer", "darkMode"],
  "conversationIdPattern": "^/a/chat/s/([^/?#]+)",
  "routeWords": ["a", "chat", "s"],
  "export": {
    "version": 1,
    "read": "virtual",
    "messageKey": "data-virtual-list-item-key"
  },
  "folders": {
    "format": 1,
    "sidebar": "div:not(.ds-scroll-area):has(> .ds-scroll-area a[href^=\"/a/chat/s/\"]:not(.ds-virtual-list *))",
    "rows": {
      "row": "a[href^=\"/a/chat/s/\"]",
      "drag": "link"
    },
    "mount": {
      "anchors": [
        {
          "id": "above-history",
          "steps": [
            {
              "find": ".ds-scroll-area > :has(> * > a[href^=\"/a/chat/s/\"])"
            },
            {
              "find": ":has(> a[href^=\"/a/chat/s/\"])"
            }
          ]
        }
      ]
    },
    "page": {
      "placeholderTitles": {
        "any": ["New chat", "新对话", "新對話", "新しいチャット", "DeepSeek", "DSeek"]
      },
      "titleSuffix": "\\s+-\\s+(?:DeepSeek|DSeek)$"
    }
  }
}
