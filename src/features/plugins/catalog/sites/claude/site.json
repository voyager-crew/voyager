{
  "$schema": "https://voyager.nagi.fun/site.schema.json",
  "id": "claude",
  "label": "Claude",
  "matches": ["https://claude.ai/*", "https://*.frame.claudeusercontent.com/*"],
  "selectors": {
    "userTurn": "[data-testid=\"user-message\"]",
    "assistantTurn": ".font-claude-message, [data-testid=\"assistant-message\"]",
    "composer": "[data-testid=\"chat-input\"][contenteditable=\"true\"]",
    "sidebar": "nav[aria-label], [data-testid=\"menu-sidebar\"], [data-testid=\"sidebar\"]",
    "scrollContainer": "[data-autoscroll-container=\"true\"]",
    "composerRoot": "[data-composer-card-holder] > div",
    "sendButton": "[data-testid=\"chat-input-send\"]",
    "sidePanel": "iframe[src*=\"claudeusercontent.com\"]"
  },
  "theme": {
    "hostSelector": ":root",
    "lightSelector": ":root[data-mode=\"light\"]",
    "darkSelector": ":root[data-mode=\"dark\"]"
  },
  "brandColor": "#d97757",
  "capabilities": ["chat", "sidebar", "composer", "darkMode"],
  "conversationIdPattern": "^/chat/([^/?#]+)",
  "routeWords": ["new", "chat", "chats", "project", "projects", "recents", "artifacts"],
  "export": {
    "version": 1,
    "read": "virtual",
    "messageKey": "data-turn-key",
    "generating": "[data-testid=\"assistant-message\"][data-is-streaming=\"true\"]"
  },
  "folders": {
    "format": 1,
    "sidebar": "[data-testid=\"sidebar\"]",
    "rows": {
      "row": "[data-row-key^=\"chat:\"]",
      "link": "a[href]",
      "title": ["[data-row-label]"],
      "observe": ["aria-current"],
      "drag": "pointer"
    },
    "mount": {
      "anchors": [
        {
          "id": "above-recents",
          "steps": [
            {
              "find": "[data-testid=\"sidebar-recents\"]"
            }
          ]
        }
      ]
    },
    "hideFiled": {
      "rows": "[data-testid=\"sidebar-recents\"] [data-row-key^=\"chat:\"]",
      "keepShown": [":has([aria-current=\"page\"])"]
    },
    "rowMenu": {
      "trigger": "button[aria-haspopup=\"menu\"][id]",
      "menu": "[role=\"menu\"][data-open][aria-labelledby]",
      "item": "[role=\"menuitem\"]",
      "open": "press",
      "template": "[data-testid=\"rename-chat-trigger\"]",
      "after": "lastSubmenu",
      "strip": ["data-testid", "aria-keyshortcuts"],
      "iconHolder": "[data-cds=\"Icon\"]"
    },
    "page": {
      "placeholderTitles": {
        "any": ["Claude", "New chat", "New session", "Untitled"]
      },
      "titleSuffix": "\\s+-\\s+Claude$"
    }
  },
  "folderSkin": {
    "rowHeight": "32px",
    "rowRadius": "var(--df-radius-pill, 8px)",
    "light": {
      "heading": "var(--cds-text-muted, #829181)",
      "text": "var(--cds-text-primary, #5c6a72)",
      "textMuted": "var(--cds-text-secondary, #708089)",
      "surface": "var(--cds-surface-popover, #fffbef)",
      "surfaceContainer": "var(--cds-surface-popover, #fffbef)",
      "surfaceHover": "var(--cds-fill-ghost-hover, rgba(11, 11, 11, 0.05))",
      "surfaceActive": "var(--cds-fill-ghost-selected, rgba(11, 11, 11, 0.1))",
      "outline": "var(--cds-border, rgba(92, 106, 114, 0.18))",
      "danger": "var(--cds-text-danger, #8e2626)",
      "dangerSoft": "color-mix(in oklab, var(--cds-fill-danger, #d03b3b) 10%, transparent)"
    },
    "dark": {
      "heading": "var(--cds-text-muted, rgba(255, 255, 255, 0.5))",
      "text": "var(--cds-text-primary, #f5f4ef)",
      "textMuted": "var(--cds-text-secondary, rgba(255, 255, 255, 0.7))",
      "surface": "var(--cds-surface-popover, #30302e)",
      "surfaceContainer": "var(--cds-surface-popover, #30302e)",
      "surfaceHover": "var(--cds-fill-ghost-hover, rgba(255, 255, 255, 0.06))",
      "surfaceActive": "var(--cds-fill-ghost-selected, rgba(255, 255, 255, 0.1))",
      "outline": "var(--cds-border, rgba(255, 255, 255, 0.12))"
    }
  }
}
