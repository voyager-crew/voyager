{
  "input.clearance": ["form, ms-prompt-input-wrapper, ms-prompt-box, ms-chunk-input"],
  "composer.keyEditables": "[contenteditable=\"true\"], [role=\"textbox\"], textarea",
  "composer.sendContainers": [
    "ms-prompt-box",
    "ms-prompt-input-wrapper",
    "ms-prompt-input",
    "ms-chat-turn-input",
    "ms-autosize-textarea",
    ".prompt-input-wrapper",
    ".prompt-input-container",
    "form",
    "[role=\"dialog\"]",
    ".mat-mdc-dialog-container"
  ],
  "input.fab": ["span.mat-mdc-button-touch-target"],
  "input.nativeOwner": ["ms-chunk-input"],
  "vim.editable": ["input, textarea, select, [contenteditable=\"true\"], [role=\"textbox\"]"],
  "vim.editInputs": [
    "textarea[aria-label=\"Edit prompt\"]",
    "textarea[aria-label=\"Edit message\"]"
  ],
  "vim.sendTarget": [
    "button[aria-label*=\"Send\"]",
    "button[aria-label*=\"send\"]",
    "button[data-tooltip*=\"Send\"]",
    "button[data-tooltip*=\"send\"]",
    "[data-send-button]",
    "button[aria-label*=\"Update\"]",
    "button[aria-label*=\"Save\"]",
    "button[aria-label*=\"更新\"]"
  ],
  "vim.editForm": [":not(*)"],
  "vim.host": [":not(*)"],
  "vim.inputFallback": [":not(*)"],
  "vim.hud": [":not(*)"],
  "vim.mountInput": [":not(*)"],
  "vim.mountRoot": [":not(*)"],
  "vim.mountChatInput": [":not(*)"],
  "vim.mountChatRoot": [":not(*)"],
  "vim.crossSiteEdit": ["textarea[aria-label=\"Edit message\"]"],
  "vim.editActions": ["button"]
}
