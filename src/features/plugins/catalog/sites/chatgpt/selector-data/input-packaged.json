{
  "input.clearance": [
    "form, .text-input-field, input-area-v2, input-container, .input-area, ms-prompt-input-wrapper, chat-message"
  ],
  "vim.editable": ["input, textarea, select, [contenteditable=\"true\"], [role=\"textbox\"]"],
  "vim.editInputs": [
    ".query-content.edit-mode textarea",
    ".edit-container textarea",
    "textarea[aria-label=\"Edit prompt\"]",
    "textarea[aria-label=\"Edit message\"]"
  ],
  "vim.sendTarget": [
    ".update-button",
    "button[aria-label*=\"Send\"]",
    "button[aria-label*=\"send\"]",
    "button[data-tooltip*=\"Send\"]",
    "button[data-tooltip*=\"send\"]",
    "button mat-icon[fonticon=\"send\"]",
    "[data-send-button]",
    ".send-button",
    "button[aria-label*=\"Update\"]",
    "button[aria-label*=\"Save\"]",
    "button[aria-label*=\"更新\"]"
  ],
  "vim.editForm": ["mat-form-field.edit-form, .edit-form"],
  "vim.host": [".text-input-field, input-area-v2, input-container"],
  "vim.inputFallback": ["rich-textarea"],
  "vim.hud": [":not(*)"],
  "vim.mountInput": ["#prompt-textarea[contenteditable=\"true\"]"],
  "vim.mountRoot": ["form"],
  "vim.crossSiteEdit": ["textarea[aria-label=\"Edit message\"]"],
  "vim.editActions": ["button"],
  "input.nativeOwner": ["form[data-chatgpt-composer]"],
  "input.fab": [":not(*)"],
  "vim.mountChatInput": ["[data-testid=\"chat-input\"][contenteditable=\"true\"]"],
  "vim.mountChatRoot": ["fieldset"]
}
