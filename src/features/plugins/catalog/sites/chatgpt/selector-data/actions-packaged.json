{
  "composerCandidates": [
    "form[data-chatgpt-composer] [contenteditable=\"true\"][role=\"textbox\"]",
    "#prompt-textarea",
    "form[data-type=\"unified-composer\"] [contenteditable=\"true\"][role=\"textbox\"]",
    "form[data-testid*=\"composer\" i] [contenteditable=\"true\"][role=\"textbox\"]"
  ],
  "genericComposer": "main form [contenteditable=\"true\"][role=\"textbox\"]",
  "composerRootFallback": "form",
  "composerEditable": "[contenteditable=\"true\"], textarea",
  "sendControls": [
    "button[data-testid=\"send-button\"]",
    "button[data-testid=\"composer-submit-button\"]",
    "form[data-chatgpt-composer] button[type=\"submit\"]"
  ],
  "submit": "button[type=\"submit\"]",
  "temporaryToggle": [
    "[data-testid=\"temporary-chat-toggle\"]",
    "button[aria-label*=\"temporary chat\" i]",
    "button[aria-label*=\"临时聊天\"]",
    "button[aria-label*=\"暫時聊天\"]"
  ],
  "temporaryOffLabels": ["close temporary", "turn off temporary", "关闭临时", "關閉暫時"],
  "newChat": "a[data-testid=\"create-new-chat-button\"], a[href=\"/\"], a[href^=\"/u/\"][href$=\"/\"]",
  "homeLink": "nav a[href=\"/\"]",
  "composerPlaceholder": "[data-placeholder]",
  "composerLabelAttributes": ["aria-label", "aria-placeholder", "placeholder"],
  "handoffObservedAttributes": ["aria-label", "aria-pressed", "data-testid", "title"],
  "userUnit": "[data-chatgpt-search-unit-key$=\":user\"]",
  "assistantUnit": "[data-chatgpt-search-unit-key$=\":assistant\"]",
  "assistantHeading": "h4[data-conversation-role]",
  "assistantMarkdown": "[data-markdown-text-style=\"assistant-message\"]",
  "turnItem": "[data-turn-key]",
  "turnStateAttribute": "data-talvt-turn-state",
  "turnStateComplete": "complete",
  "thinking": "span.loading-shimmer, [aria-busy=\"true\"], [role=\"progressbar\"], progress, .result-streaming, [data-message-streaming=\"true\"], [data-is-streaming=\"true\"]",
  "replyActions": "button",
  "replyNotice": "[role=\"alert\"], [role=\"status\"], [aria-live]",
  "replyAlert": "[role=\"alert\"], [aria-live=\"assertive\"]",
  "interruptedCopy": ["^connection interrupted\\b", "^连接已中断"],
  "interruptedAnywhere": "connection interrupted|连接已中断",
  "fileInput": "input[type=\"file\"]",
  "attachmentBusy": [
    "[aria-busy=\"true\"]",
    "[data-state=\"loading\"]",
    "[data-state=\"uploading\"]",
    "[data-state=\"pending\"]",
    ".animate-spin"
  ],
  "attachmentNotice": "[role=\"alert\"], [role=\"status\"], [data-sonner-toast], [data-radix-toast-viewport] li, [class*=\"toast\" i]",
  "attachmentControl": "button, [role=\"button\"]",
  "attachmentCards": "[data-composer-attachments] > *",
  "attachmentArea": "[data-composer-attachments]",
  "attachmentMarkerAttributes": ["data-attachment-id", "data-file-id"],
  "attachmentPreview": "[data-testid*=\"attachment\" i], [data-testid*=\"file\" i], [aria-label], [title]",
  "attachmentMarkers": "[data-attachment-id], [data-file-id], [data-testid]",
  "attachmentRemovalPreview": "[data-attachment-id], [data-file-id], [data-testid*=\"attachment\" i], [data-testid*=\"file\" i]",
  "attachmentProgress": "progress, [role~=\"progressbar\"]",
  "modeButton": "button",
  "modeHomeStateAttribute": "data-state",
  "sourceUploadedAt": "time[datetime]",
  "sourceBusy": "[aria-busy=\"true\"], [role=\"progressbar\"], progress",
  "pickerLabelledTrigger": "button[aria-haspopup=\"menu\"][aria-label]",
  "shareButton": "[data-testid=\"share-chat-button\"]",
  "composerNativeRoot": "form[data-chatgpt-composer]",
  "composerNativeEditable": "textarea, [contenteditable=\"true\"], [contenteditable=\"plaintext-only\"]"
}
