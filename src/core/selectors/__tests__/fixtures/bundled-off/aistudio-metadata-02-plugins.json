[
  [
    "plugins/enter-send/plugin.json",
    {
      "id": "voyager.aistudio-enter-send",
      "engine": ">=1.9.0",
      "tier": "declarative",
      "matches": ["https://aistudio.google.com/*", "https://aistudio.google.cn/*"],
      "contributes": {
        "domOps": [
          {
            "op": "native",
            "handler": "sendShortcut",
            "params": {
              "mode": "enterSends"
            }
          }
        ]
      }
    }
  ],
  [
    "plugins/folders/plugin.json",
    {
      "id": "voyager.aistudio-folders",
      "engine": ">=1.10.0",
      "tier": "declarative",
      "matches": ["https://aistudio.google.com/*", "https://aistudio.google.cn/*"],
      "requires": {
        "handlers": ["folders"]
      },
      "contributes": {
        "settings": {
          "hideFiledChats": {
            "type": "boolean",
            "label": "Hide prompts already in folders from the Library list",
            "default": false
          }
        },
        "domOps": [
          {
            "op": "native",
            "handler": "folders",
            "params": {}
          }
        ]
      }
    }
  ],
  [
    "plugins/formula-copy/plugin.json",
    {
      "id": "voyager.aistudio-formula-copy",
      "engine": ">=1.3.0",
      "tier": "declarative",
      "matches": ["https://aistudio.google.com/*", "https://aistudio.google.cn/*"],
      "requires": {
        "handlers": ["formulaCopy"]
      },
      "contributes": {
        "domOps": [
          {
            "op": "native",
            "handler": "formulaCopy",
            "params": {}
          }
        ]
      }
    }
  ],
  [
    "plugins/palette/plugin.json",
    {
      "id": "voyager.aistudio-palette",
      "engine": ">=1.11.0",
      "tier": "declarative",
      "matches": ["https://aistudio.google.com/*", "https://aistudio.google.cn/*"],
      "contributes": {
        "settings": {
          "palette": {
            "type": "select",
            "label": "Palette",
            "default": "nord",
            "options": [
              {
                "value": "nord",
                "label": "Nord, following the page's light or dark"
              },
              {
                "value": "nord-dark",
                "label": "Nord dark, always"
              },
              {
                "value": "nord-light",
                "label": "Nord light, always"
              }
            ]
          }
        },
        "styles": [
          {
            "file": "style.css"
          }
        ],
        "domOps": [
          {
            "op": "setAttribute",
            "target": "html",
            "name": "data-gv-palette",
            "value": "{{palette}}"
          }
        ]
      }
    }
  ],
  [
    "plugins/site-check/plugin.json",
    {
      "id": "voyager.aistudio-site-check",
      "engine": ">=1.10.0",
      "tier": "declarative",
      "matches": ["https://aistudio.google.com/*", "https://aistudio.google.cn/*"],
      "contributes": {
        "domOps": [
          {
            "op": "native",
            "handler": "siteCheck",
            "params": {}
          }
        ]
      }
    }
  ]
]
