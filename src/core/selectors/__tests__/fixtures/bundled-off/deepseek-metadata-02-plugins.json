    "plugins/reading-typography/plugin.json",
    {
      "id": "voyager.deepseek-reading-typography",
      "engine": ">=1.4.0",
      "tier": "declarative",
      "matches": ["https://chat.deepseek.com/*"],
      "requires": {
        "semantic": ["assistantTurn"]
      },
      "contributes": {
        "settings": {
          "fontSizeEnabled": {
            "type": "boolean",
            "label": "Custom text size",
            "default": false
          },
          "fontSize": {
            "type": "number",
            "enabledBy": "fontSizeEnabled",
            "label": "Text size (%)",
            "minLabel": "Small",
            "maxLabel": "Large",
            "default": 100,
            "min": 80,
            "max": 150
          },
          "spacingEnabled": {
            "type": "boolean",
            "label": "Custom spacing",
            "default": false
          },
          "lineHeight": {
            "type": "number",
            "enabledBy": "spacingEnabled",
            "label": "Line height (%)",
            "minLabel": "Tight",
            "maxLabel": "Loose",
            "default": 160,
            "min": 120,
            "max": 220
          },
          "paragraphSpacing": {
            "type": "number",
            "enabledBy": "spacingEnabled",
            "label": "Paragraph spacing (px)",
            "minLabel": "Tight",
            "maxLabel": "Loose",
            "default": 16,
            "min": 0,
            "max": 24
          }
        },
        "styles": [
          {
            "file": "style.css"
          }
        ],
        "domOps": [
          {
            "op": "addClass",
            "target": {
              "kind": "semantic",
              "key": "assistantTurn"
            },
            "className": "gv-plugin-deepseek-reading-typography"
          },
          {
            "op": "setAttribute",
            "target": {
              "kind": "semantic",
              "key": "assistantTurn"
            },
            "name": "data-gv-font-size",
            "value": "{{fontSizeEnabled}}"
          },
          {
            "op": "setAttribute",
            "target": {
              "kind": "semantic",
              "key": "assistantTurn"
            },
            "name": "data-gv-spacing",
            "value": "{{spacingEnabled}}"
          },
          {
            "op": "setStyle",
            "target": "body",
            "styles": {
              "--gv-plugin-reading-text-size": "{{fontSize}}%",
              "--gv-plugin-reading-text-scale": "{{fontSize}}",
              "--gv-plugin-reading-line-height": "{{lineHeight}}",
              "--gv-plugin-reading-paragraph-spacing": "{{paragraphSpacing}}px"
            }
          }
        ]
      }
    }
  ],
