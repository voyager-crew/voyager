[
  [
    "plugins/code-collapse/plugin.json",
    {
      "id": "voyager.deepseek-code-collapse",
      "engine": ">=1.8.0",
      "tier": "declarative",
      "matches": ["https://chat.deepseek.com/*"],
      "requires": {
        "handlers": ["codeCollapse"]
      },
      "contributes": {
        "domOps": [
          {
            "op": "native",
            "handler": "codeCollapse",
            "params": {
              "action": ".md-code-block-banner [role=\"button\"]",
              "code": "pre"
            }
          }
        ]
      }
    }
  ],
  [
    "plugins/composer-counter/plugin.json",
    {
      "id": "voyager.deepseek-composer-counter",
      "engine": ">=1.8.0",
      "tier": "declarative",
      "matches": ["https://chat.deepseek.com/*"],
      "contributes": {
        "settings": {
          "metric": {
            "type": "select",
            "label": "What to count",
            "default": "chars",
            "options": [
              {
                "value": "chars",
                "label": "Characters"
              },
              {
                "value": "words",
                "label": "Words"
              },
              {
                "value": "cjkChars",
                "label": "CJK characters"
              },
              {
                "value": "lines",
                "label": "Lines"
              }
            ]
          }
        },
        "domOps": [
          {
            "op": "native",
            "handler": "counterBadge",
            "params": {
              "target": "composer",
              "metric": "{{metric}}"
            }
          }
        ]
      }
    }
  ],
