[
  [
    "plugins/collapse-long-messages/plugin.json",
    {
      "id": "voyager.chatgpt-collapse-long-messages",
      "engine": ">=1.8.0",
      "tier": "declarative",
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "contributes": {
        "settings": {
          "maxHeight": {
            "type": "number",
            "label": "Collapsed text height (px)",
            "minLabel": "Shorter",
            "maxLabel": "Taller",
            "default": 320,
            "min": 80,
            "max": 2000
          },
          "startCollapsed": {
            "type": "boolean",
            "label": "Collapse long messages initially",
            "default": true
          }
        },
        "domOps": [
          {
            "op": "native",
            "handler": "collapse",
            "params": {
              "target": "userTurn",
              "maxPx": "{{maxHeight}}",
              "startCollapsed": "{{startCollapsed}}"
            }
          }
        ]
      }
    }
  ],
  [
    "plugins/composer-counter/plugin.json",
    {
      "id": "voyager.chatgpt-composer-counter",
      "engine": ">=1.8.0",
      "tier": "declarative",
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "contributes": {
        "settings": {
          "metric": {
            "type": "select",
            "label": "What to count",
            "default": "chars",
            "options": [
              {
                "value": "chars",
                "label": "Characters"
              },
              {
                "value": "words",
                "label": "Words"
              },
              {
                "value": "cjkChars",
                "label": "CJK characters"
              },
              {
                "value": "lines",
                "label": "Lines"
              }
            ]
          }
        },
        "domOps": [
          {
            "op": "native",
            "handler": "counterBadge",
            "params": {
              "target": "composer",
              "metric": "{{metric}}"
            }
          }
        ]
      }
    }
  ],
  [
    "plugins/ctrl-enter-send/plugin.json",
    {
      "id": "voyager.chatgpt-ctrl-enter-send",
      "engine": ">=1.8.0",
      "tier": "declarative",
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "contributes": {
        "domOps": [
          {
            "op": "native",
            "handler": "sendShortcut",
            "params": {}
          }
        ]
      }
    }
  ],
  [
    "plugins/diagram-rendering/plugin.json",
    {
      "id": "voyager.chatgpt-diagram-rendering",
      "engine": ">=1.7.0",
      "tier": "declarative",
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "requires": {
        "handlers": ["echarts", "wavedrom"]
      },
      "contributes": {
        "domOps": [
          {
            "op": "native",
            "handler": "echarts",
            "params": {
              "language": "[data-markdown-copy=\"exclude\"] .truncate"
            }
          },
          {
            "op": "native",
            "handler": "wavedrom",
            "params": {
              "language": "[data-markdown-copy=\"exclude\"] .truncate"
            }
          }
        ]
      }
    }
  ],
  [
