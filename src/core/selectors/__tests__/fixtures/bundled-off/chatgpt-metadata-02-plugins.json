  [
    "plugins/reading-typography/plugin.json",
    {
      "id": "voyager.chatgpt-reading-typography",
      "engine": ">=1.4.0",
      "tier": "declarative",
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "requires": {
        "semantic": ["assistantTurn"]
      },
      "contributes": {
        "settings": {
          "fontSizeEnabled": {
            "type": "boolean",
            "label": "Custom text size",
            "default": false
          },
          "fontSize": {
            "type": "number",
            "enabledBy": "fontSizeEnabled",
            "label": "Text size (%)",
            "minLabel": "Small",
            "maxLabel": "Large",
            "default": 100,
            "min": 80,
            "max": 150
          },
          "spacingEnabled": {
            "type": "boolean",
            "label": "Custom spacing",
            "default": false
          },
          "lineHeight": {
            "type": "number",
            "enabledBy": "spacingEnabled",
            "label": "Line height (%)",
            "minLabel": "Tight",
            "maxLabel": "Loose",
            "default": 160,
            "min": 120,
            "max": 220
          },
          "paragraphSpacing": {
            "type": "number",
            "enabledBy": "spacingEnabled",
            "label": "Paragraph spacing (px)",
            "minLabel": "Tight",
            "maxLabel": "Loose",
            "default": 16,
            "min": 0,
            "max": 24
          }
        },
        "styles": [
          {
            "file": "style.css"
          }
        ],
        "domOps": [
          {
            "op": "addClass",
            "target": {
              "kind": "semantic",
              "key": "assistantTurn"
            },
            "className": "gv-plugin-chatgpt-reading-typography"
          },
          {
            "op": "setAttribute",
            "target": {
              "kind": "semantic",
              "key": "assistantTurn"
            },
            "name": "data-gv-font-size",
            "value": "{{fontSizeEnabled}}"
          },
          {
            "op": "setAttribute",
            "target": {
              "kind": "semantic",
              "key": "assistantTurn"
            },
            "name": "data-gv-spacing",
            "value": "{{spacingEnabled}}"
          },
          {
            "op": "setStyle",
            "target": "body",
            "styles": {
              "--gv-plugin-reading-text-size": "{{fontSize}}%",
              "--gv-plugin-reading-text-scale": "{{fontSize}}",
              "--gv-plugin-reading-line-height": "{{lineHeight}}",
              "--gv-plugin-reading-paragraph-spacing": "{{paragraphSpacing}}px"
            }
          }
        ]
      }
    }
  ],
  [
    "plugins/reading-width/plugin.json",
    {
      "id": "voyager.chatgpt-reading-width",
      "engine": ">=1.2.0",
      "tier": "declarative",
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "contributes": {
        "settings": {
          "width": {
            "type": "number",
            "label": "Reading width (px)",
            "minLabel": "Narrower",
            "maxLabel": "Wider",
            "default": 768,
            "min": 600,
            "max": 1600
          },
          "centerConversation": {
            "type": "boolean",
            "label": "Center conversation content",
            "default": false
          }
        },
        "styles": [
          {
            "file": "style.css"
          }
        ],
        "domOps": [
          {
            "op": "addClass",
            "target": "body",
            "className": "gv-plugin-chatgpt-readable"
          },
          {
            "op": "setStyle",
            "target": "body",
            "styles": {
              "--gv-plugin-reading-width": "{{width}}px"
            }
          },
          {
            "op": "setAttribute",
            "target": "body",
            "name": "data-gv-center-conversation",
            "value": "{{centerConversation}}"
          }
        ]
      }
    }
  ],
