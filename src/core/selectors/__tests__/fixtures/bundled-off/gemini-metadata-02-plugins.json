  [
    "plugins/echarts/plugin.json",
    {
      "id": "voyager.gemini-echarts",
      "engine": ">=1.9.0",
      "tier": "declarative",
      "matches": ["https://gemini.google.com/*"],
      "contributes": {
        "domOps": [
          {
            "op": "native",
