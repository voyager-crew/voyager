[
  [
    "plugins/chat-font-size/plugin.json",
    {
      "id": "voyager.gemini-chat-font-size",
      "engine": ">=1.8.0",
      "tier": "declarative",
      "matches": ["https://gemini.google.com/*"],
      "contributes": {
        "settings": {
          "fontSize": {
            "type": "number",
            "label": "Chat font size (%)",
            "minLabel": "Small",
            "maxLabel": "Large",
            "default": 100,
            "min": 80,
            "max": 150
          }
        },
        "styles": [
          {
            "file": "style.css"
          }
        ]
      }
    }
  ],
  [
    "plugins/chat-line-height/plugin.json",
    {
      "id": "voyager.gemini-chat-line-height",
      "engine": ">=1.8.0",
      "tier": "declarative",
      "matches": ["https://gemini.google.com/*"],
      "contributes": {
        "settings": {
          "lineHeight": {
            "type": "number",
            "label": "Line height (%)",
            "minLabel": "Tight",
            "maxLabel": "Loose",
            "default": 160,
            "min": 120,
            "max": 220
          },
          "paragraphSpacing": {
            "type": "number",
            "label": "Paragraph spacing (px)",
            "minLabel": "Tight",
            "maxLabel": "Loose",
            "default": 12,
            "min": 0,
            "max": 24
          }
        },
        "styles": [
          {
            "file": "style.css"
          }
        ]
      }
    }
  ],
  [
    "plugins/code-collapse/plugin.json",
    {
      "id": "voyager.gemini-code-collapse",
      "engine": ">=1.9.0",
      "tier": "declarative",
      "matches": ["https://gemini.google.com/*"],
      "requires": {
        "handlers": ["codeCollapse"],
        "semantic": ["assistantTurn", "codeBlock"]
      },
      "contributes": {
        "domOps": [
          {
            "op": "native",
            "handler": "codeCollapse",
            "params": {}
          }
        ]
      }
    }
  ],
  [
    "plugins/ctrl-enter-send/plugin.json",
