          "width": {
            "type": "number",
            "label": "Reading width (px)",
            "minLabel": "Narrower",
            "maxLabel": "Wider",
            "default": 1000,
            "min": 600,
            "max": 1600
          }
        },
        "styles": [
          {
            "file": "style.css"
          }
        ],
        "domOps": [
          {
            "op": "addClass",
            "target": "body",
            "className": "gv-plugin-kimi-readable"
          },
          {
            "op": "setStyle",
            "target": "body",
            "styles": {
              "--gv-plugin-reading-width": "{{width}}px"
            }
          }
        ]
      }
    }
  ],
