[
  [
    "plugins/composer-counter/plugin.json",
    {
      "id": "voyager.kimi-composer-counter",
      "engine": ">=1.8.0",
      "tier": "declarative",
      "matches": ["https://www.kimi.com/*"],
      "contributes": {
        "settings": {
          "metric": {
            "type": "select",
            "label": "What to count",
            "default": "chars",
            "options": [
              {
                "value": "chars",
                "label": "Characters"
              },
              {
                "value": "words",
                "label": "Words"
              },
              {
                "value": "cjkChars",
                "label": "CJK characters"
              },
              {
                "value": "lines",
                "label": "Lines"
              }
            ]
          }
        },
        "domOps": [
          {
            "op": "native",
            "handler": "counterBadge",
            "params": {
              "target": "composer",
              "metric": "{{metric}}"
            }
          }
        ]
      }
    }
  ],
  [
