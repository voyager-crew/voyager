{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voyager.nagi.fun/site.schema.json",
  "title": "Voyager site adapter",
  "description": "A site adapter as data (site.json). One of these sits at catalog/sites/<site>/site.json and its `id` must equal that directory name. Hand-written to mirror validateSiteAdapterData in src/features/plugins/sites/siteAdapterData.ts, which is the authority; unknown keys are ignored rather than rejected, exactly as the validator ignores them. The same shape is embedded in a published per-host catalog file, where it may override the bundled adapter.",
  "type": "object",
  "required": ["id", "label", "matches", "theme"],
  "properties": {
    "catalogRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Source order stamped by the catalog pipeline; remote data replaces bundled data only at a strictly newer revision."
    },
    "$schema": {
      "type": "string",
      "description": "This schema's URL, so editors validate the file as you type."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,39}$",
      "description": "Stable adapter id; must equal the `sites/<dir>` directory name.",
      "examples": ["claude", "chatgpt", "deepseek"]
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "description": "Human-readable site name shown in the popup."
    },
    "matches": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 500,
        "pattern": "^(?:https?|\\*)://(?:\\*\\.)?[A-Za-z0-9.-]+/.*$",
        "description": "A match pattern with a concrete or `*.` host. The validator matches the scheme case-insensitively; write it lowercase."
      },
      "description": "Every URL this site covers. A plugin filed under this site may not target anything outside these patterns.",
      "examples": [["https://claude.ai/*", "https://*.frame.claudeusercontent.com/*"]]
    },
    "selectors": {
      "type": "object",
      "description": "Semantic key → site-specific CSS selector. Plugins and primitives reference the KEY, never the selector, so a site redesign is a one-file fix here. The vocabulary only ever grows; a key outside it is rejected so nobody invents one silently.",
      "propertyNames": {
        "enum": [
          "userTurn",
          "assistantTurn",
          "thinkingBlock",
          "codeBlock",
          "composer",
          "sidebar",
          "sidePanel",
          "headerActions",
          "scrollContainer",
          "composerRoot",
          "sendButton"
        ]
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "theme": {
      "type": "object",
      "description": "How to tell the site's light mode from its dark mode, so Voyager's own UI can follow it.",
      "required": ["hostSelector", "lightSelector", "darkSelector"],
      "properties": {
        "hostSelector": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "Element that carries the theme class (e.g. `:root`, `body`)."
        },
        "lightSelector": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "Selector present when the site is in light mode."
        },
        "darkSelector": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "Selector present when the site is in dark mode."
        }
      }
    },
    "brandColor": {
      "type": "string",
      "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
      "description": "Optional accent (strict hex — it is concatenated into a CSS `color-mix(...)`) for Voyager's own UI on this site. A matching plugin's `theme.brand` overrides it; omit to keep Voyager's native green.",
      "examples": ["#d97757"]
    },
    "capabilities": {
      "type": "array",
      "description": "Coarse flags describing what the site exposes, so a contribution the site cannot support is skipped.",
      "items": {
        "type": "string",
        "enum": ["chat", "sidebar", "composer", "darkMode"]
      }
    },
    "conversationIdPattern": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "format": "regex",
      "description": "Regular expression over `location.pathname` whose first capture group is the conversation id. Not a selector. Omit for sites without per-conversation routes.",
      "examples": ["^/chat/([^/?#]+)"]
    },
    "routeWords": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_-]{1,64}$"
      },
      "description": "Static router segments site-check reports may retain. Every other path segment is redacted; queries and hashes are always omitted. Only lower-case letters, digits, underscores and hyphens are allowed; never put conversation or account identifiers here.",
      "examples": [["chat", "new", "library"]]
    },
    "accountSlots": {
      "type": "boolean",
      "default": false,
      "description": "Whether bundled site-check rules retain one- or two-digit /u/<n>/ account slots."
    },
    "conversationRoutes": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "maxLength": 520,
        "pattern": "^/(?:[a-z0-9_-]{1,64}|:id)(?:/(?:[a-z0-9_-]{1,64}|:id)){0,7}$"
      },
      "description": "Bundled redacted conversation routes checked without an account-slot prefix when conversationIdPattern is absent.",
      "examples": [["/app/:id", "/gem/:id/:id"]]
    },
    "prompt": {
      "$ref": "site-sections/prompt.schema.json"
    },
    "turnKeyAttributes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      },
      "description": "Attributes that keep one user message's identity across re-renders and remounts, read from the `userTurn` element or its nearest ancestor carrying one; the first present wins. Send tracking (folder Activity, timeline timestamps) needs them to tell the message a send produced from older ones mounting. Omit where the site has none: those features then stay off there.",
      "examples": [["data-turn-key", "data-message-id"]]
    },
    "export": {
      "type": "object",
      "required": ["version", "read"],
      "description": "Page facts for conversationExport. Messages and scroll container use the site's semantic selectors. Virtual reads require messageKey; mounted reads snapshot only currently mounted messages. Omit to leave generic export unavailable.",
      "if": {
        "properties": {
          "read": {
            "const": "virtual"
          }
        },
        "required": ["read"]
      },
      "then": {
        "required": ["messageKey"]
      },
      "properties": {
        "version": {
          "const": 1
        },
        "read": {
          "type": "string",
          "enum": ["mounted", "virtual"]
        },
        "messageKey": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "description": "Export-only message identity attribute, read from the turn itself or its nearest ancestor. Required for virtual reads. Does not enable send tracking, timestamps or folder Activity."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "Document selector for the conversation title."
        },
        "generating": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "Document selector present while the site is generating a response."
        }
      }
    },
    "modelPicker": {
      "$ref": "site-sections/model-picker.schema.json"
    },
    "projects": {
      "$ref": "site-sections/projects.schema.json"
    },
    "pageHooks": {
      "$ref": "site-sections/page-hooks.schema.json"
    },
    "folders": {
      "$ref": "site-sections/folders.schema.json"
    },
    "folderSkin": {
      "$ref": "site-sections/folder-skin.schema.json"
    },
    "bridge": {
      "type": "object",
      "description": "Local Bridge kill switch: the ops the extension may run for `voyager serve` on this site. A missing or invalid section denies every op, and only a fresh remote catalog newer than the packaged one can allow them. Removing an op from `allow` revokes it at the next catalog revision.",
      "required": ["format", "allow"],
      "properties": {
        "format": {
          "const": 1,
          "description": "Policy format version; an unknown format denies the bridge."
        },
        "allow": {
          "type": "array",
          "maxItems": 40,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "conversation.open",
              "conversation.close",
              "conversation.ready",
              "model.inspect",
              "model.select",
              "composer.attach",
              "composer.send",
              "turns.waitReply",
              "turns.read",
              "files.download",
              "project.list",
              "project.create",
              "project.open",
              "project.files",
              "project.upload",
              "project.remove"
            ]
          },
          "description": "Allowed op names. Every op, including the ones the service worker runs itself, must be listed."
        }
      }
    },
    "locators": {
      "type": "object",
      "description": "Ordered page locator profiles for the named site. Each site has a packaged literal allowlist and independent rejection groups. Account and content identity, destructive actions and interaction policies remain packaged.",
      "maxProperties": 75,
      "propertyNames": {
        "enum": [
          "activity.inputs",
          "bridge.replyContent",
          "canvas.codePanels",
          "code.host",
          "composer.candidates",
          "composer.draftCandidates",
          "composer.sendContainers",
          "content.answer",
          "content.userLines",
          "context.images",
          "export.assistantContent",
          "exportOverlay.canvas",
          "exportOverlay.composer",
          "gems.description",
          "gems.icon",
          "gems.list",
          "gems.navEntry",
          "gems.row",
          "gems.title",
          "generatedImage.downloadIcon",
          "imageExport.searchHosts",
          "input.candidates",
          "input.handoff",
          "input.sendContainers",
          "inputCollapse.wrapper",
          "library.archivableRows",
          "library.rows",
          "library.table",
          "menu.content",
          "menu.panels",
          "modelPicker.container",
          "modelPicker.focusInput",
          "modelPicker.items",
          "modelPicker.legacyPanels",
          "modelPicker.modelEvidence",
          "modelPicker.modelIdItem",
          "modelPicker.modelLabel",
          "modelPicker.modelTitleContainer",
          "modelPicker.observerRoot",
          "modelPicker.overlayPane",
          "modelPicker.panelFallback",
          "modelPicker.thinkingContent",
          "modelPicker.thinkingItems",
          "modelPicker.thinkingLabel",
          "modelPicker.thinkingRow",
          "modelPicker.thinkingTitleContainer",
          "modelPicker.trigger",
          "navigation.libraryLink",
          "project.inputs",
          "promptHistory.candidates",
          "researchPack.actionBars",
          "responseActions.bars",
          "sentChips.bubbles",
          "sidebar.allConversations",
          "sidebar.conversationLinks",
          "sidebar.forkRoots",
          "sidebar.history",
          "sidebar.host",
          "sidebar.interactionButton",
          "sidebar.links",
          "sidebar.notebooks",
          "sidebar.openHost",
          "sidebar.overflow",
          "sidebar.recents",
          "sidebar.row",
          "sidebar.rowContainer",
          "sidebar.scroller",
          "sidebar.section",
          "sidebar.title",
          "sidebar.titleFallback",
          "sidebar.visibilityHost",
          "sidebarHover.dialogs",
          "sidebarHover.menus",
          "sidebarWidth.buttons",
          "slash.candidates",
          "turn.assistant",
          "turn.assistantFallback",
          "turn.assistantWithHosts",
          "turn.user",
          "turn.userWithHosts",
          "usage.root",
          "userLatex.lines",
          "vim.candidates",
          "vim.configuredComposer"
        ]
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 32,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["locators"]
      },
      "then": {
        "properties": {
          "id": {
            "enum": ["gemini", "aistudio", "chatgpt", "claude", "deepseek", "kimi"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "id": {
            "const": "gemini"
          }
        },
        "required": ["id"]
      },
      "then": {
        "properties": {
          "locators": {
            "maxProperties": 75,
            "propertyNames": {
              "enum": [
                "turn.user",
                "turn.userWithHosts",
                "turn.assistant",
                "turn.assistantFallback",
                "turn.assistantWithHosts",
                "sidebar.overflow",
                "sidebar.notebooks",
                "sidebar.recents",
                "sidebar.allConversations",
                "sidebar.history",
                "sidebar.section",
                "sidebar.row",
                "sidebar.rowContainer",
                "sidebar.openHost",
                "sidebar.host",
                "sidebar.visibilityHost",
                "sidebar.links",
                "sidebar.conversationLinks",
                "sidebar.title",
                "sidebar.titleFallback",
                "sidebar.scroller",
                "sidebar.interactionButton",
                "sidebar.forkRoots",
                "modelPicker.trigger",
                "modelPicker.legacyPanels",
                "modelPicker.panelFallback",
                "modelPicker.overlayPane",
                "modelPicker.container",
                "modelPicker.observerRoot",
                "modelPicker.items",
                "modelPicker.modelEvidence",
                "modelPicker.modelIdItem",
                "modelPicker.modelLabel",
                "modelPicker.thinkingLabel",
                "modelPicker.thinkingRow",
                "modelPicker.thinkingItems",
                "modelPicker.thinkingContent",
                "modelPicker.modelTitleContainer",
                "modelPicker.thinkingTitleContainer",
                "modelPicker.focusInput",
                "composer.candidates",
                "composer.draftCandidates",
                "composer.sendContainers",
                "inputCollapse.wrapper",
                "vim.configuredComposer",
                "vim.candidates",
                "promptHistory.candidates",
                "slash.candidates",
                "sentChips.bubbles",
                "project.inputs",
                "activity.inputs",
                "menu.panels",
                "menu.content",
                "exportOverlay.canvas",
                "exportOverlay.composer",
                "sidebarWidth.buttons",
                "sidebarHover.dialogs",
                "sidebarHover.menus",
                "gems.navEntry",
                "gems.list",
                "gems.row",
                "gems.title",
                "gems.description",
                "gems.icon",
                "content.answer",
                "content.userLines",
                "context.images",
                "responseActions.bars",
                "researchPack.actionBars",
                "usage.root",
                "code.host",
                "userLatex.lines",
                "imageExport.searchHosts",
                "generatedImage.downloadIcon",
                "canvas.codePanels"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "id": {
            "const": "aistudio"
          }
        },
        "required": ["id"]
      },
      "then": {
        "properties": {
          "locators": {
            "maxProperties": 6,
            "propertyNames": {
              "enum": [
                "input.candidates",
                "input.sendContainers",
                "library.rows",
                "library.archivableRows",
                "library.table",
                "navigation.libraryLink"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "id": {
            "const": "chatgpt"
          }
        },
        "required": ["id"]
      },
      "then": {
        "properties": {
          "locators": {
            "maxProperties": 6,
            "propertyNames": {
              "enum": [
                "input.candidates",
                "vim.candidates",
                "input.handoff",
                "export.assistantContent",
                "bridge.replyContent",
                "input.handoff"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "id": {
            "const": "claude"
          }
        },
        "required": ["id"]
      },
      "then": {
        "properties": {
          "locators": {
            "maxProperties": 5,
            "propertyNames": {
              "enum": [
                "input.candidates",
                "vim.candidates",
                "input.handoff",
                "export.assistantContent",
                "input.handoff"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "id": {
            "const": "deepseek"
          }
        },
        "required": ["id"]
      },
      "then": {
        "properties": {
          "locators": {
            "maxProperties": 1,
            "propertyNames": {
              "enum": ["export.assistantContent"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "id": {
            "const": "kimi"
          }
        },
        "required": ["id"]
      },
      "then": {
        "properties": {
          "locators": {
            "maxProperties": 3,
            "propertyNames": {
              "enum": ["input.candidates", "vim.candidates", "export.assistantContent"]
            }
          }
        }
      }
    }
  ]
}
