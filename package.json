{
  "name": "voyager",
  "version": "1.9.0",
  "description": "A better workspace for Gemini, Claude, ChatGPT, and DeepSeek: prompts, reading tools, organization, export, and more.",
  "packageManager": "bun@1.3.12",
  "license": "GPL-3.0",
  "author": "Jesse Zhang",
  "repository": {
    "type": "git",
    "url": "https://github.com/voyager-crew/voyager.git"
  },
  "scripts": {
    "bump": "bun scripts/bump-version.js",
    "build": "vite build --config vite.config.chrome.ts",
    "build:chrome": "vite build --config vite.config.chrome.ts",
    "build:edge": "bun scripts/build-edge.js",
    "build:firefox": "vite build --config vite.config.firefox.ts",
    "build:safari": "vite build --config vite.config.safari.ts && node scripts/verify-safari-resources.mjs",
    "build:all": "bun run build:chrome && bun run build:firefox && bun run build:safari",
    "build:browsers": "bun run build:all && bun run build:edge",
    "dev": "nodemon --config nodemon.chrome.json",
    "dev:chrome": "nodemon --config nodemon.chrome.json",
    "dev:chrome-open": "bun scripts/launch-chrome.cjs",
    "dev:firefox": "nodemon --config nodemon.firefox.json",
    "dev:safari": "nodemon --config nodemon.safari.json",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:changed": "vitest run --changed main",
    "test:watch": "vitest watch",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "clean:build": "find .build -mindepth 1 -maxdepth 1 ! -name sparkle-source-packages -exec rm -rf {} + && echo 'Cleared Xcode derived data (kept .build/sparkle-source-packages).'",
    "i18n:check": "node scripts/check-locale-keys.mjs",
    "bench:folders": "bun bench/folders/run.ts",
    "filesize:check": "node scripts/check-file-size.mjs",
    "filesize:update": "node scripts/check-file-size.mjs --update",
    "typecheck": "tsc --noEmit",
    "verify:pr": "bun run format:check && bun run lint:check && bun run typecheck && bun run i18n:check && bun run filesize:check && bun run plugin:check && bun run test && bun run build:all && bun run docs:build",
    "verify:katex-export": "bun scripts/verify-katex-export.ts",
    "commitlint": "commitlint --edit $GIT_PARAMS",
    "catalog:build": "bun scripts/build-plugin-catalog.ts",
    "plugin:new": "bun scripts/plugin-new.ts",
    "plugin:check": "bun scripts/plugin-check.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "sponsors:update": "bun run scripts/generate-sponsors.cjs",
    "hooks:install": "node scripts/install-git-hooks.cjs",
    "prepare": "node scripts/install-git-hooks.cjs"
  },
  "type": "module",
  "dependencies": {
    "@floating-ui/dom": "1.8.0",
    "@headless-tree/core": "1.7.0",
    "@tanstack/virtual-core": "3.17.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3",
    "echarts": "6.1.0",
    "html-to-image": "^1.11.13",
    "json5": "^2.2.3",
    "katex": "^0.16",
    "lucide-react": "^0.553.0",
    "marked": "16.4.1",
    "marked-katex-extension": "^4",
    "mermaid": "11.12.2",
    "mermaid-legacy": "npm:mermaid@9.2.2",
    "onml": "^2.1.0",
    "preact": "10.27.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.1",
    "temml": "^0.13.1",
    "wavedrom": "3.6.2",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.2.1",
    "@nolebase/vitepress-plugin-git-changelog": "^2.18.2",
    "@tailwindcss/vite": "^4.1.15",
    "@types/chrome": "^0.1.24",
    "@types/jsdom": "^27.0.0",
    "@types/jszip": "^3.4.1",
    "@types/node": "^24.9.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/webextension-polyfill": "^0.12.3",
    "@vitejs/plugin-react": "5.1.0",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "chrome-webstore-upload-cli": "3.5.0",
    "esbuild": "0.25.11",
    "fs-extra": "^11.3.0",
    "jsdom": "^27.1.0",
    "jszip": "^3.10.1",
    "nodemon": "^3.1.10",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "tailwindcss": "^4.1.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vite": "^7.1.11",
    "vite-tsconfig-paths": "^5.1.4",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.3",
    "vue": "^3.5.24",
    "vue3-marquee": "^4.2.2",
    "web-ext": "10.5.0",
    "web-ext-run": "^0.2.4"
  },
  "overrides": {
    "rollup": "^4.24.0"
  }
}
